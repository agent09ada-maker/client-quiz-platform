# Copy this file to .env for local development, and set the same
# variables in your hosting provider's dashboard (e.g. Vercel > Settings > Environment Variables) for production.

# Local dev: SQLite file. Production: a Postgres URL from Neon/Supabase (free tier).
DATABASE_URL="file:./dev.db"

# Any long random string — used to sign login session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# From https://console.anthropic.com/settings/keys — needed for AI question generation.
ANTHROPIC_API_KEY="sk-ant-..."

# Only used once, by `npm run seed`, to create your first admin login.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMe123!"
